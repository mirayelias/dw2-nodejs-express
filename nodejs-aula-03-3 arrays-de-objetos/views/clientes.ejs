<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Clientes</title>
  </head>
  <body>
    <h1>Tela de Clientes</h1>
    <hr>
    <!-- Percorrendo vetor através do foreach -->
    <% listaClientes.forEach(function(cliente) { %>
      <p>
        <a href="/clientes/<%= cliente %>">
          <%= cliente %>
        </a>
      </p>
    <% }) %>

      <p><a href="/">Voltar</a></p>
  </body>
</html>
