<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Produtos</title>
  </head>
  <body>
    <h1>Produtos</h1>
    <hr>

    <!-- Exibindo uma variável Javascript dentro do HTML-->
    <!-- Comentário no EJS <%# %> -->


      <!-- Percorrendo vetor atráves do foreach -->
        <% listaProdutos.forEach(function(produto) { %>
          <p>
            <a href="/produtos/<%= produto %>">
              <%= produto %>
            </a>


          </p>
        <% }) %>

     <p><a href="/">Voltar</a></p>
  </body>
</html>
