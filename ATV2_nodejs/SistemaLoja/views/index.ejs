<%- include ('partials/header.ejs') %>
<%- include ('partials/navbar.ejs') %>

    <div class="container">
        <div class="jumbotron game-hero">
            <h1 class="display-5"><strong>Bem-vindo(a) a Hollow Faith!</strong></h1>
            <p class="lead">Uma aventura poderosa começa aqui. Explore recordes de tempo, itens lendários e os personagens que movem a história.</p>
            <hr class="my-4">
            <p class="currentDate"></p>
            <img src="/imgs/Logo_HollowFaith.png" alt="Logo Hollow Faith" class="main-game-logo">
            <p class="release-date">Lançamento previsto: 21/08/2029</p>
            <div class="hero-extra">
                <div class="hero-feature">
                    <strong>Modo história épico</strong>
                    <p>Campanha sombria com escolhas e finais diferentes.</p>
                </div>
                <div class="hero-feature">
                    <strong>Armas e magia</strong>
                    <p>Personalize Levi com espadas amaldiçoadas e feitiços antigos.</p>
                </div>
                <div class="hero-feature">
                    <strong>Atmosfera dark</strong>
                    <p>Ambientes góticos, tempestades e criaturas profanas.</p>
                </div>
            </div>
        </div>
        <div class="row image-cards text-center mt-4">
            <div class="col-md-6 mb-3">
                <a class="icon-card-link" href="/itens">
                    <div class="icon-card">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" aria-label="Baú de Itens" role="img" class="icon-card-svg">
                            <defs>
                                <linearGradient id="chestWood" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" stop-color="#8b5a2b" />
                                    <stop offset="100%" stop-color="#b07a4b" />
                                </linearGradient>
                                <linearGradient id="chestMetal" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" stop-color="#d4af37" />
                                    <stop offset="100%" stop-color="#b8860b" />
                                </linearGradient>
                            </defs>
                            <path d="M14 24h36v22H14z" fill="url(#chestWood)" stroke="#6d4223" stroke-width="2"/>
                            <path d="M14 24l-4 10v8h44v-8l-4-10" fill="#8b5a2b" stroke="#6d4223" stroke-width="2"/>
                            <path d="M14 24h36v6H14z" fill="#5c341d"/>
                            <path d="M22 18h20v10H22z" fill="#8b5a2b" stroke="#6d4223" stroke-width="2"/>
                            <path d="M26 20h12v6H26z" fill="url(#chestMetal)"/>
                            <circle cx="32" cy="30" r="3" fill="#4a2f1b"/>
                            <path d="M30 18l-4 8h20l-4-8" fill="#b07a4b" stroke="#6d4223" stroke-width="2"/>
                        </svg>
                        <h3>Itens</h3>
                        <p>Veja armas, armaduras e artefatos raros.</p>
                    </div>
                </a>
            </div>
            <div class="col-md-6 mb-3">
                <a class="icon-card-link" href="/recordes">
                    <div class="icon-card">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" aria-label="Medalha de Recordes" role="img" class="icon-card-svg">
                            <defs>
                                <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" stop-color="#ffe66d" />
                                    <stop offset="100%" stop-color="#d4af37" />
                                </linearGradient>
                                <linearGradient id="ribbonGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" stop-color="#b62845" />
                                    <stop offset="100%" stop-color="#8b1833" />
                                </linearGradient>
                            </defs>
                            <path d="M18 8c-3 8-2 18 4 24l6-6c-3-4-4-10-2-16L18 8z" fill="url(#ribbonGrad)"/>
                            <path d="M46 8c3 8 2 18-4 24l-6-6c3-4 4-10 2-16L46 8z" fill="url(#ribbonGrad)"/>
                            <circle cx="32" cy="26" r="16" fill="url(#goldGrad)" stroke="#c69f1f" stroke-width="2"/>
                            <circle cx="32" cy="26" r="10" fill="#fff3b7"/>
                            <circle cx="32" cy="26" r="5" fill="#f6e27f"/>
                            <path d="M32 18l1.8 4.8 5.1.1-4.1 3 1.6 5-4.4-2.5-4.4 2.5 1.6-5-4.1-3 5.1-.1L32 18z" fill="#e1b92f" opacity="0.98"/>
                            <path d="M16 40c0 9 6 16 16 16s16-7 16-16V28H16v12z" fill="url(#goldGrad)" stroke="#c69f1f" stroke-width="2"/>
                            <path d="M22 28l-4 12h8l4-12h-8z" fill="#b77f12"/>
                            <path d="M42 28l4 12h-8l-4-12h8z" fill="#b77f12"/>
                        </svg>
                        <h3>Recordes</h3>
                        <p>Confira os melhores tempos de zerar Hollow Faith.</p>
                    </div>
                </a>
            </div>
        </div>
        <div class="row character-section text-center mt-4">
            <div class="col-md-4 mb-3">
                <div class="character-card">
                    <h3>Levi, the Cursed Chosen</h3>
                    <p>O escolhido amaldiçoado. Um guerreiro sombrio que usa sua maldição como arma em cada ataque.</p>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="character-card">
                    <h3>Serapha, Weaver of Sins</h3>
                    <p>A Tecelã de Pecados. Uma bruxa que trama o destino dos heróis através de culpa e trevas.</p>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="character-card">
                    <h3>Vorgath, the Profaned Flame</h3>
                    <p>O dragão de Vorgath, a Chama Profanada. Um ser incendiário que consome tudo em fogo abissal.</p>
                </div>
            </div>
        </div>
    </div>
    
<%- include ('partials/footer.ejs') %>
