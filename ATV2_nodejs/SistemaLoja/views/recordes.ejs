<%- include ('partials/header.ejs') %>
<%- include ('partials/navbar.ejs') %>

<div class="container">
    <div class="card mt-3">
        <div class="card-header">
            <h2>Recordes</h2>
        </div>
        <div class="card-body">
            <p>Veja os melhores tempos para zerar Hollow Faith. O desafio é completar a jornada antes do resto do mundo.</p>
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Jogador</th>
                        <th>Tempo</th>
                    </tr>
                </thead>
                <tbody>
                    <% recordes.forEach((recorde, index) => { %>
                    <tr>
                        <td><%= index + 1 %></td>
                        <td><%= recorde.nome %></td>
                        <td><%= recorde.tempo %></td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
            <a class="btn btn-primary" href="/">Voltar ao início</a>
        </div>
    </div>
</div>

<%- include ('partials/footer.ejs') %>